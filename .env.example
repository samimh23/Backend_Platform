NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
# Local Docker Postgres (docker compose up -d)
DATABASE_URL=postgres://pos:pos@localhost:5434/pos
# Owner login tokens — generate your own: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=dev-only-secret-change-me-dev-only-secret-change-me
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
