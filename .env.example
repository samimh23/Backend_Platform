NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
# Local Docker Postgres (docker compose up -d)
DATABASE_URL=postgres://pos:pos@localhost:5434/pos
# Owner login tokens — generate your own: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=dev-only-secret-change-me-dev-only-secret-change-me
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
# Website address (links in emails)
WEB_URL=http://localhost:3001
# Emails (Brevo). Without BREVO_API_KEY, emails are saved as .html files in MAIL_DIR instead of being sent.
# Put the real key ONLY in .env (never commit it). MAIL_FROM must be a sender verified in Brevo.
BREVO_API_KEY=
MAIL_FROM=
MAIL_FROM_NAME=Kahwti
MAIL_DIR=.mail-outbox
